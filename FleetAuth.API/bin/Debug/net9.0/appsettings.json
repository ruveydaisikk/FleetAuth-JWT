{
  "ConnectionStrings": {
    "Default": "Host=localhost;Database=fleetauth;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Secret": "fleet-auth-super-secret-key-min-32-chars!",
    "Issuer": "FleetAuth",
    "Audience": "FleetAuthUsers"
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "POST:/api/auth/login",
        "Period": "10m",
        "Limit": 5
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}